      "Severity": "warn"
    },
    "Disk Full Notification": {
      "Name": "Disk Full Notification",
      "Enabled": true,
      "Period": "latest",
      "TrackingMetric": "cosmos.system.disk./",
      "Condition": {
        "Operator": "gt",
        "Value": 95,
        "Percent": true
      },
      "Actions": [
        {
          "Type": "notification",
          "Target": ""
        }
      ],
      "LastTriggered": "0001-01-01T00:00:00Z",
      "Throttled": true,
      "Severity": "warn"
    },
    "Disk Health": {
      "Name": "Disk Health",
      "Enabled": true,
      "Period": "latest",
      "TrackingMetric": "system.disk-health.temperature.*",
      "Condition": {
        "Operator": "gt",
        "Value": 50,
        "Percent": false
      },
      "Actions": [
        {
          "Type": "notification",
          "Target": ""
        }
      ],
      "LastTriggered": "0001-01-01T00:00:00Z",
