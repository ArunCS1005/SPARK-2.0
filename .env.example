# SPARK settings. Copy to `.env` (the installer does this for you) and fill in.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Folder holding users/, shared/, media/, backups/, apps/. Absolute path.
SPARK_DATA=/srv/spark

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Public hostname of this SPARK install (one hostname; apps live on paths like /files).
#   Own domain:      spark.yourdomain.com
#   Friend of owner: <handle>.<owner-domain>   (given to you by the owner)
#   This laptop only: spark.localhost   (no tunnel; plain http://spark.localhost in a browser
#                    on this laptop; needs SPARK_HTTP_PORT=80. Good for trying SPARK out.)
SPARK_HOSTNAME=spark.example.com

# Local port for SPARK (http://localhost:<port>). By default only this laptop can use it.
# Set SPARK_HTTP_BIND=0.0.0.0 to let other devices on a TRUSTED home network connect
# (it is plain HTTP — never do this on college/public Wi-Fi). Everyone else uses SPARK_HOSTNAME.
SPARK_HTTP_PORT=8080
SPARK_HTTP_BIND=127.0.0.1

# Cloudflare Tunnel token. Leave empty and use the `quick-tunnel` profile for testing only.
TUNNEL_TOKEN=

# Your country code, used by Cosmos's geo-blocking so it never blocks you.
COSMOS_SERVER_COUNTRY=IN

TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Profiles (comma separated): tunnel | quick-tunnel   (add-ons come in a later release)
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=tunnel

# The admin account is NOT configured here: the install script asks for it and passes it to
# `spark setup` for that one run only (SPARK_ADMIN_USER / SPARK_ADMIN_PASSWORD / SPARK_ADMIN_EMAIL).

# ---------------------------------------------------------------------------
# Owner only: tunnels for your own domain or for friends (`spark tunnel new <name>`).
# Never give these to anyone. Token needs: Account > Cloudflare Tunnel: Edit, Zone > DNS: Edit.
# ---------------------------------------------------------------------------
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# ---------------------------------------------------------------------------
# Pinned image versions (bumped deliberately, never `latest`)
# ---------------------------------------------------------------------------
COSMOS_VERSION=0.23.4
FILEBROWSER_VERSION=2.0.2-stable
CLOUDFLARED_VERSION=2026.10.0
